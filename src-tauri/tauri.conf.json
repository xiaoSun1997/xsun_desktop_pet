{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xsun_desktop_pet",
  "version": "0.1.0",
  "identifier": "com.xsun.pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "系统信息",
        "width": 200,
        "height": 600,
        "decorations": true
      },
      {
        "label": "pet",
        "title": "桌宠",
        "width": 320,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "fullscreen": false      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
