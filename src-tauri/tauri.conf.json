{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xsun_desktop_pet",
  "version": "0.1.0",
  "identifier": "com.xsun.pet",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [

      {
        "label": "pet",
        "title": "桌宠",
        "width": 500,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "shadow": false,
        "skipTaskbar": true,
        "focusable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "drag",
        "window-management",
        "main-capability"
      ]
    }
  },
  "bundle": {
    "resources": [
      "config/*"
    ],
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/favicon-16x16.png",
      "icons/favicon-32x32.png",
      "icons/favicon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}