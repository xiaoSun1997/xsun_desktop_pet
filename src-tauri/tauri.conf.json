{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xsun_desktop_pet",
  "version": "0.1.0",
  "identifier": "com.xsun.pet",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "系统信息",
        "width": 200,
        "height": 600,
        "decorations": true
      },
      {
        "label": "pet",
        "title": "桌宠",
        "width": 300,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "shadow": false,
        "skipTaskbar": true,
        "focusable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["drag", "window-management", "main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}