{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xsun_desktop_pet",
  "version": "0.1.0",
  "identifier": "com.xsun.pet",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "系统信息",
        "width": 400,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": false
      },
      {
        "label": "pet",
        "title": "桌宠",
        "width": 500,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "shadow": false,
        "skipTaskbar": true,
        "focusable": true
      },
      {
        "label": "clipboard",
        "title": "剪贴板历史",
        "width": 400,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "ai-chat",
        "title": "AI对话助手",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "minWidth": 600,
        "minHeight": 500
      },
      {
        "label": "translator",
        "title": "有道翻译",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "minWidth": 800,
        "minHeight": 600
      },
      {
        "label": "calendar",
        "title": "智能日历",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "drag",
        "window-management",
        "main-capability"
      ]
    }
  },
  "bundle": {
    "resources": [
      "config/*"
    ],
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": [
        "$RESOURCE/**",
        "$APPDATA/**"
      ]
    }
  }
}