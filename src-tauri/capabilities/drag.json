{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "drag",
  "description": "Allow frontend to start native window dragging and manage click-through",
  "windows": [
    "pet","main"
  ],
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events"
  ]
}
